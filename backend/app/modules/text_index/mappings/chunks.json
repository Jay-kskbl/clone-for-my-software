{
  "settings": {
    "index": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "similarity": {
        "default": {
          "type": "BM25",
          "k1": 1.2,
          "b": 0.75
        }
      }
    },
    "analysis": {
      "analyzer": {
        "docmgr_text": {
          "type": "smartcn"
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "chunk_id": {"type": "keyword"},
      "document_id": {"type": "keyword"},
      "parse_version": {"type": "keyword"},
      "seq": {"type": "integer"},
      "source_type": {"type": "keyword"},
      "text": {"type": "text", "analyzer": "docmgr_text"},
      "locator": {"type": "object", "enabled": false}
    }
  }
}
